---
import AddToCartForm from '@/features/product-browse/views/components/AddToCartForm.tsx';
import { formVariants, optionLabel, priceSummary, pricesVary } from '@/data/Product/product-display';
import { shopifyImageUrl, shopifySrcSet } from '@/utilities/shopify-image-url';
import { withBase } from '@/utilities/with-base';
import type { ShopifyProduct } from '@/services/shopify/products';

interface Props {
  product: ShopifyProduct;
  /** In the opening viewport: load now instead of lazily. */
  eager?: boolean;
  /** The single most important image on the page (LCP candidate): fetched at high priority. */
  priority?: boolean;
  /** Scroll-reveal effect. Off for the first row, which is in the opening viewport. */
  reveal?: boolean;
}
const { product, eager = false, priority = false, reveal = true } = Astro.props;
const href = withBase(`/shop/${product.handle}/`);
const image = product.featuredImage;
const sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---

<li data-reveal={reveal ? true : undefined} class="card group relative overflow-hidden">
  <div class="relative block aspect-square overflow-hidden bg-muted">
    {image && (
      <img
        src={shopifyImageUrl(image.url, 640, 640)}
        srcset={shopifySrcSet(image.url, [320, 640, 960], 1) || undefined}
        {sizes}
        alt=""
        width="640"
        height="640"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
        class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
  </div>
  <div class="p-6">
    {/* The title link is stretched over the whole card (after:absolute), so there is one named link, not an image link plus a title link. */}
    <h2 class="text-2xl"><a href={href} class="after:absolute after:inset-0">{product.title}</a></h2>
    <p class="mt-1 font-semibold tabular-nums">{priceSummary(product)}</p>
    <div class="relative z-10">
      <AddToCartForm client:visible name={product.title} optionLabel={optionLabel(product)} variants={formVariants(product)} showVariantPrices={pricesVary(product)} />
    </div>
  </div>
</li>
