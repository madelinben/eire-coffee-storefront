---
import { siteContent } from '@/data/Content/site-content';
const { story, values } = siteContent.home;
---

<section class="mx-auto max-w-6xl px-6 section-y">
  <p data-reveal class="eyebrow text-muted-foreground">The Éire way</p>
  <p data-reveal class="mt-4 max-w-4xl font-display text-2xl leading-snug text-primary sm:text-4xl">{story}</p>
  <ul class="mt-16 grid gap-6 md:grid-cols-3">
    {values.map((value, index) => (
      <li data-reveal style={`--reveal-delay:${index * 100}ms`} class="border-t border-primary pt-6">
        <p class="font-display text-5xl italic text-ring" aria-hidden="true">0{index + 1}</p>
        <h3 class="mt-3 text-2xl">{value.title}</h3>
        <p class="mt-3 text-muted-foreground">{value.text}</p>
      </li>
    ))}
  </ul>
</section>
