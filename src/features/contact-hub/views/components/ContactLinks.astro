---
import { withBase } from '@/utilities/with-base';
import { socialLinks } from '@/data/Content/settings';

const links = [
  { label: 'Book the trailer', detail: 'Weddings, festivals and private events', href: withBase('/book/'), tone: 'bg-primary text-primary-foreground' },
  socialLinks.email && { label: 'Email', detail: socialLinks.email, href: `mailto:${socialLinks.email}`, tone: 'bg-card' },
  socialLinks.whatsappNumber && { label: 'WhatsApp', detail: 'Message us', href: `https://wa.me/${socialLinks.whatsappNumber}`, tone: 'bg-card' },
  socialLinks.instagram && { label: 'Instagram', detail: '@eire_coffee, where we post each week’s stops', href: socialLinks.instagram, tone: 'bg-secondary text-secondary-foreground' },
  socialLinks.facebook && { label: 'Facebook', detail: 'Follow along', href: socialLinks.facebook, tone: 'bg-card' },
  socialLinks.tiktok && { label: 'TikTok', detail: 'Behind the hatch', href: socialLinks.tiktok, tone: 'bg-card' },
].filter((link) => typeof link === 'object');
---

<ul class="grid gap-5 sm:grid-cols-2">
  {links.map((link) => (
    <li data-reveal>
      <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined} class={`${link.tone} card flex min-h-28 flex-col justify-between p-7 press`}>
        <span class="font-display text-3xl">{link.label}</span>
        <span class="mt-3 break-words text-sm">{link.detail}</span>
      </a>
    </li>
  ))}
</ul>
