---
import type { HireContent } from '@/data/Content/schemas';
interface Props {
  packages: HireContent['packages'];
}
const { packages } = Astro.props;
---

<ul class="grid gap-6 md:grid-cols-3">
  {packages.map((item, index) => (
    <li data-reveal style={`--reveal-delay:${index * 90}ms`} class="card flex flex-col p-7">
      <p class="eyebrow text-muted-foreground">{item.bestFor}</p>
      <h3 class="mt-3 text-3xl text-primary">{item.name}</h3>
      <p class="mt-3">{item.summary}</p>
      <ul class="mt-5 space-y-2 border-t border-border pt-5 text-sm">
        {item.includes.map((entry) => (
          <li class="flex gap-3"><span aria-hidden="true" class="mt-1.5 size-1.5 shrink-0 rotate-45 bg-accent"></span>{entry}</li>
        ))}
      </ul>
    </li>
  ))}
</ul>
