---
import { requireSite } from '@/utilities/require-site';
import PageLayout from '@/layouts/PageLayout.astro';
import CartLauncher from '@/features/cart-manage/views/components/CartLauncher.tsx';
import ProductCard from '@/features/product-browse/views/components/ProductCard.astro';
import PageBanner from '@/features/site-shell/views/components/PageBanner.astro';
import { getProductsServer } from '@/data/Product/get-products-server';
import { settings } from '@/data/Content/settings';
import { itemListNode } from '@/features/site-seo/utilities/schema-nodes';
import { toAbsolute, withBase } from '@/utilities/with-base';
import { shopifyImageUrl } from '@/utilities/shopify-image-url';

const products = await getProductsServer();
const site = requireSite(Astro.site);
const url = toAbsolute(site, '/shop/');
const absolute = (path: string) => toAbsolute(site, path);
---

<PageLayout
  title="Coffee and Merch Shop"
  description="Shop Éire Coffee beans and merchandise online and collect from the mobile coffee trailer in Chester. Good coffee to take home."
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Shop', path: '/shop/' }]}
  schema={products.length === 0 ? [] : [itemListNode(url, products.map((product) => ({ url: absolute(`/shop/${product.handle}/`), name: product.title, image: absolute(shopifyImageUrl(product.featuredImage?.url ?? '/og-default.png', 800, 800)) })))]}
>
  <CartLauncher slot="actions" client:idle />
  <PageBanner title="The shop" kicker="Take a bit of Éire home" lede={settings.shopNote} art="cup" />
  <section class="mx-auto max-w-6xl px-6 section-y">
    {products.length === 0 ? (
      <div class="card bg-secondary p-10 text-secondary-foreground">
        <h2 class="text-3xl">Coming soon</h2>
        <p class="mt-3 max-w-prose">Nothing in the shop right now. Follow us on <a class="font-semibold underline" href={withBase('/contact/')}>Instagram</a> to hear when beans and merch land.</p>
      </div>
    ) : (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product, index) => <ProductCard product={product} eager={index < 3} priority={index === 0} reveal={index >= 3} />)}
      </ul>
    )}
  </section>
</PageLayout>
