---
import { withBase } from '@/utilities/with-base';
import PageLayout from '@/layouts/PageLayout.astro';
import Illustration from '@/features/site-shell/views/components/Illustration.astro';
---

<PageLayout title="Page Not Found" description="That page does not exist. Head back to the Éire Coffee home page, find the trailer or get in touch with us." noindex>
  <section class="mx-auto grid max-w-5xl items-center gap-10 px-6 py-24 md:grid-cols-[1.4fr_1fr]">
    <div>
      <p class="eyebrow text-muted-foreground">404</p>
      <h1 class="mt-3 text-5xl sm:text-7xl">Lost at sea</h1>
      <p class="mt-6 max-w-prose">That page does not exist. If you typed the address, check it. If you pasted it, copy the whole address. Or follow the light back to somewhere useful.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/')} class="btn btn-primary press">Home</a>
        <a href={withBase('/calendar/')} class="btn btn-outline press">Find the trailer</a>
      </div>
    </div>
    <div aria-hidden="true" class="justify-self-center text-primary"><Illustration name="lighthouse" class="h-72 w-auto" /></div>
  </section>
</PageLayout>
