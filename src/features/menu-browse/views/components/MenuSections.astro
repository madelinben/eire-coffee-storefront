---
import { siteContent } from '@/data/Content/site-content';
const { sections } = siteContent.menu;
---

<div class="grid gap-12 lg:grid-cols-2">
  {sections.map((section, index) => (
    <section data-reveal style={`--reveal-delay:${(index % 2) * 90}ms`} aria-labelledby={`menu-${index}`}>
      <h2 id={`menu-${index}`} class="border-b border-border pb-3 text-4xl text-primary">{section.name}</h2>
      {section.note && <p class="mt-3 text-muted-foreground">{section.note}</p>}
      <ul class="mt-2 divide-y divide-border">
        {section.items.map((item) => (
          <li class="flex items-baseline justify-between gap-6 py-4">
            <div>
              <h3 class="font-display text-xl font-medium">{item.name}</h3>
              {item.description && <p class="mt-1 max-w-md text-sm text-muted-foreground">{item.description}</p>}
            </div>
            {item.price && <p class="shrink-0 font-semibold tabular-nums">{item.price}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
