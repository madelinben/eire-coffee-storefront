---
import { Image } from 'astro:assets';
import { withBase } from '@/utilities/with-base';
import { siteContent, pictureImages } from '@/data/Content/site-content';
import { SERVICE_AREA } from '@/data/Content/settings';
import Illustration from '@/features/site-shell/views/components/Illustration.astro';

const { headline, subline } = siteContent.home;
// The first picture marked for the home page leads, as an arched window; otherwise the lighthouse illustration does.
const heroPicture = siteContent.pictures.find((picture) => picture.hero && pictureImages.has(picture.id));
const heroImage = heroPicture ? pictureImages.get(heroPicture.id) : undefined;
const [first = headline, ...rest] = headline.split('. ');
---

<section class="relative isolate overflow-hidden bg-secondary text-secondary-foreground">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 pb-28 pt-14 lg:min-h-[calc(100svh-5rem)] lg:grid-cols-[1.15fr_0.85fr] lg:pb-32 lg:pt-10">
    <div>
      <p class="hero-rise eyebrow" style="--i:0">Mobile coffee trailer · {SERVICE_AREA}</p>
      <h1 class="hero-rise mt-5 text-6xl sm:text-8xl" style="--i:1">
        {rest.length > 0 ? <>{first}.<span class="block italic">{rest.join('. ')}</span></> : headline}
      </h1>
      <p class="hero-rise mt-8 max-w-xl text-lg sm:text-xl" style="--i:2">{subline}</p>
      <p class="hero-rise mt-10 flex flex-wrap gap-3" style="--i:3">
        <a href={withBase('/calendar/')} class="btn btn-primary press">Find the trailer</a>
        <a href={withBase('/book/')} class="btn btn-outline press">Book us for your event</a>
      </p>
    </div>
    <div aria-hidden={heroPicture ? undefined : 'true'} class="art-in justify-self-center text-primary lg:justify-self-end">
      {heroImage && heroPicture ? (
        <Image src={heroImage} alt={heroPicture.alt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 90vw" loading="eager" fetchpriority="high" decoding="sync" class="aspect-[4/5] w-full max-w-md rounded-t-[999px] object-cover" />
      ) : (
        <Illustration name="lighthouse" cut="var(--secondary)" class="h-[26rem] w-auto sm:h-[34rem]" />
      )}
    </div>
  </div>
</section>
