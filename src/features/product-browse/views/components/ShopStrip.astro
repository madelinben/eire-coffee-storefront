---
import { withBase } from '@/utilities/with-base';
import { shopifyImageUrl } from '@/utilities/shopify-image-url';
import { priceSummary } from '@/data/Product/product-display';
import type { ShopifyProduct } from '@/services/shopify/products';

interface Props {
  products: ShopifyProduct[];
  heading?: string;
  /** The strip is in the opening viewport (a product page on a tablet), so load its pictures now. */
  eager?: boolean;
}
const { products, heading = 'Take a bit of Éire home', eager = false } = Astro.props;
---

{products.length > 0 && (
  <section class="mx-auto max-w-6xl px-6 section-y">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <h2 data-reveal class="text-4xl sm:text-6xl">{heading}</h2>
      <a data-reveal href={withBase('/shop/')} class="btn btn-outline press">Visit the shop</a>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.slice(0, 3).map((product, index) => (
        <li data-reveal="scale" style={`--reveal-delay:${index * 90}ms`}>
          <a href={withBase(`/shop/${product.handle}/`)} class="tilt card group flex h-full flex-col overflow-hidden">
            {product.featuredImage && (
              <img src={shopifyImageUrl(product.featuredImage.url, 640, 640)} alt="" width="640" height="640" loading={eager ? 'eager' : 'lazy'} decoding="async" class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            )}
            <span class="flex flex-1 items-baseline justify-between gap-3 p-6">
              <span class="font-display text-xl">{product.title}</span>
              <span class="font-semibold tabular-nums">{priceSummary(product)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
