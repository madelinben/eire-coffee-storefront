# Both values are safe to expose: the Storefront public access token is designed for browsers.
PUBLIC_SHOPIFY_STORE_DOMAIN=
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Build-time origin for canonical URLs, OG tags and the sitemap.
SITE_ORIGIN=http://localhost:4321
# Search Console HTML-tag verification value (the content="..." part). The meta tag is omitted until this is set.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Booking requests: a form endpoint that accepts a JSON POST (Formspree, Web3Forms, Basin...). Leave empty and the form hands the request
# to email, WhatsApp or Instagram instead (docs/environment/booking.md).
PUBLIC_BOOKING_ENDPOINT=
# Content editor at /admin/ (docs/ADMIN.md). Stops, menu, packages, contact links and photos are edited there, or in src/content/site/*.json.
PUBLIC_ADMIN_ENABLED=
PUBLIC_ADMIN_REPOSITORY=
PUBLIC_ADMIN_BRANCH=main
PUBLIC_ADMIN_CONTENT_ROOT=
# Optional. Point at the local mock (node scripts/mock-storefront.mjs) to develop without a store.
PUBLIC_SHOPIFY_STOREFRONT_URL=
